<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <!--
      xUnit.net v3 test projects are executables. Microsoft.NET.Test.Sdk used to set this for us;
      it is gone with the move to Microsoft.Testing.Platform, so the project sets it itself.
      Without it, xunit.v3.core.mtp-v2.targets fails the build.
    -->
    <OutputType>Exe</OutputType>

    <!--
      Run on Microsoft.Testing.Platform rather than xUnit.net's own console runner. The runner is
      selected when the entry point is generated, so this decides how the built executable behaves
      when it is started directly, and it is what makes the extension options below available.
      IsTestingPlatformApplication is already true by default (xunit.v3.core.mtp-v2.props), which is
      what lets `dotnet test` discover this project; the VSTest target refuses to run such a project
      on the .NET 10 SDK, so global.json opts the repository into the MTP `dotnet test` experience.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reporting and coverage are platform extensions, not built-in: an option is only recognised
      when the test application registers the package that provides it, otherwise the run fails
      with exit code 5. xunit.v3 registers the report writers behind the report-xunit-trx option,
      and Microsoft.Testing.Extensions.CodeCoverage registers the coverage option. The CI pipeline's
      test step passes both.
    -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Resultify\Resultify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
