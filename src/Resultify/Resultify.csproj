<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<!-- Match CI, which builds with -warnaserror, so a warning fails locally too. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>

		<!-- Fail the build on any accidental break of the published API surface. -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>

		<!-- Deterministic paths in the symbol package when building on a CI runner. -->
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- NuGet package metadata -->
		<PackageId>Riddersholm.Resultify</PackageId>
		<!--
			Source of truth for local builds and for CI builds of main and pull requests; a release takes its
			version from the tag instead. It must not drop below PackageValidationBaselineVersion: package
			validation rejects an assembly version lower than the baseline's (CP0003).
		-->
		<Version>2.0.0</Version>
		<Authors>Jesper Bruhn Riddersholm</Authors>
		<Company>Jesper Bruhn Riddersholm</Company>
		<Product>Resultify</Product>
		<Title>Resultify</Title>
		<Description>A modern, immutable, allocation-conscious Result pattern for .NET 10. Zero-allocation success path via readonly struct, first-class async pipelines, and a rich error model with codes, metadata, and causal chains.</Description>
		<PackageTags>result;result-pattern;railway-oriented-programming;rop;functional;error-handling;ddd;clean-architecture;cqs</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/Riddersholm1/Resultify</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Riddersholm1/Resultify</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) 2026 Jesper Bruhn Riddersholm</Copyright>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
	</ItemGroup>
</Project>